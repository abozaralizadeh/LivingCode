# Copy to .env and fill in. Never commit real values.

# --- The local lab (scripts/demo.py, the livingcode command) ---
# The lab runs on the local fake LLM, so it doesn't need any of these.

# Which config file the commands use. Defaults to lab/etc/sample.toml.
LIVINGCODE_CONFIG=lab/etc/sample.toml

# Your own LLM key. Only used if a real provider is set in the config, and the
# lab lock refuses real providers for now.
LIVINGCODE_LLM_API_KEY=

# --- The web demo (python3 -m livingcode.webdemo.front) ---
# setup_service.sh sets PORT and TRUST_PROXY for you on the VM.
PORT=8606
HOST=127.0.0.1
# Behind a local nginx, trust only it for the visitor's address: 127.0.0.1
TRUST_PROXY=

# Azure OpenAI. Endpoint like https://<resource>.openai.azure.com, and the deployment name.
# With these empty the demo runs on the scripted fake AI and costs nothing.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Optional second deployment, tried only when the first one fails
AZURE_OPENAI_FALLBACK_ENDPOINT=
AZURE_OPENAI_FALLBACK_API_KEY=
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-5-mini
# auto uses Azure when it's set, fake forces the scripted fake AI
LIVINGCODE_WEB_LLM=auto

# Limits. A visitor can only pick one of the planted bugs, never type anything.
# Most AI tokens (in plus out) per UTC day across the demo. 0 means no daily budget.
DAILY_TOKEN_BUDGET=400000
# Most AI tokens one run may use
RUN_TOKEN_CAP=80000
DAILY_RUN_CAP=40
RUNS_PER_IP_PER_DAY=3
RUN_TIMEOUT_SECONDS=300
MAX_WATCHERS=100

# The web demo's log file is capped at this size, with two older copies kept
LOG_MAX_BYTES=5242880
